      "webhookId": "776882ee-4d36-4d88-9b0a-c134e1b25c45"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const description = $json[\"Problem Description\"].toLowerCase();\n\nconst subject = $json[\"Subject\"].toLowerCase();\n\nlet priority = \"Normal\";\n\nconst urgentWords = [\n  \"hacked\",\n  \"security breach\",\n  \"stolen\",\n  \"cannot access\",\n  \"account locked\",\n  \"cannot login\"\n];\n\nconst importantWords = [\n  \"payment\",\n  \"billing\",\n  \"refund\",\n  \"error\",\n  \"failed\"\n];\n\nif (urgentWords.some(word =>\n  description.includes(word) || subject.includes(word)\n)) {\n  priority = \"Urgent\";\n} else if (importantWords.some(word =>\n  description.includes(word) || subject.includes(word)\n)) {\n  priority = \"Important\";\n}\n\nreturn {\n  ...$json,\n  priority: priority\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
