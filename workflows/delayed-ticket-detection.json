        "mode": "runOnceForEachItem",
        "jsCode": "const createdAt = new Date($json.createdAt);\n\nconst now = new Date();\n\nconst difference = now - createdAt;\n\nconst daysOpen = difference / (1000 * 60 * 60 * 24);\n\nconst status = $json.status;\n\nconst isDelayed = daysOpen > 3 && status!== \"Resolved\";\n\nreturn {\n  ...$json,\n  daysOpen: daysOpen,\n  isDelayed: isDelayed\n};"
